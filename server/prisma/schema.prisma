generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "mysql"
}

model plans {
  id            Int       @id @default(autoincrement())
  name          String    @unique @db.VarChar(50)
  max_users     Int       @default(1)
  max_cards     Int       @default(5)
  price_monthly Decimal?  @db.Decimal(10, 2)
  price_yearly  Decimal?  @db.Decimal(10, 2)
  features      Json?
  status        String    @default("active") @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.DateTime(0)
  accounts      accounts[]
  subscription_history subscription_history[]
}

model accounts {
  id            Int                 @id @default(autoincrement())
  name          String?             @default("Minha Conta") @db.VarChar(100)
  plan_id       Int
  status        accounts_status?    @default(trial)
  trial_ends_at DateTime?           @db.DateTime(0)
  current_period_ends_at DateTime?  @db.DateTime(0)
  grace_period_ends_at DateTime?    @db.DateTime(0)
  cancelled_at DateTime?            @db.DateTime(0)
  created_at    DateTime?           @default(now()) @db.DateTime(0)
  plans         plans               @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "accounts_plan_fk")
  transactions  transactions[]
  users         users[]
  financial_entities financial_entities[]
  categories    categories[]
  subscription_history subscription_history[]

  @@index([plan_id], map: "accounts_plan_idx")
}

/// Auditoria imutavel de toda transicao comercial da assinatura.
model subscription_history {
  id              Int       @id @default(autoincrement())
  account_id      Int
  plan_id         Int
  previous_status accounts_status?
  new_status      accounts_status
  reason          String    @db.VarChar(100)
  metadata        Json?
  created_at      DateTime  @default(now()) @db.DateTime(0)
  accounts        accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plans           plans     @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id, created_at])
}

/// Caixa de entrada idempotente para eventos de qualquer futuro provedor.
model billing_webhook_events {
  id                Int       @id @default(autoincrement())
  provider          String    @db.VarChar(50)
  provider_event_id String    @db.VarChar(191)
  event_type        String    @db.VarChar(100)
  payload           Json
  status            String    @default("received") @db.VarChar(20)
  attempts          Int       @default(0)
  error_message     String?   @db.Text
  received_at       DateTime  @default(now()) @db.DateTime(0)
  processed_at      DateTime? @db.DateTime(0)

  @@unique([provider, provider_event_id])
}

model budgets {
  id           Int       @id @default(autoincrement())
  user_id      Int
  category     String    @db.VarChar(50)
  amount_limit Decimal   @db.Decimal(10, 2)
  month_ref    String?   @db.VarChar(7)
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "budgets_ibfk_1")

  @@unique([user_id, category], map: "unique_user_category")
}

model categories {
  id         Int       @id @default(autoincrement())
  account_id Int
  name       String    @db.VarChar(50)
  type       String    @db.VarChar(20)
  color      String?   @default("#3b82f6") @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  accounts   accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "categories_account_fk")
  transactions transactions[]
  recurring_transactions recurring_transactions[]

  @@unique([account_id, name, type], map: "unique_account_category_type")
  @@index([account_id], map: "categories_account_idx")
}

model events {
  id              Int       @id @default(autoincrement())
  user_id         Int
  google_event_id String?   @db.VarChar(255)
  title           String    @db.VarChar(150)
  event_date      DateTime  @db.DateTime(0)
  description     String?   @db.Text
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "events_ibfk_1")

  @@index([google_event_id], map: "idx_google_event")
  @@index([user_id], map: "user_id")
}

model financial_entities {
  id                    Int                     @id @default(autoincrement())
  account_id            Int
  created_by_user_id    Int?
  name                  String                  @db.VarChar(100)
  type                  financial_entities_type
  balance               Decimal?                @default(0.00) @db.Decimal(10, 2)
  credit_limit          Decimal?                @default(0.00) @db.Decimal(10, 2)
  closing_day           Int?
  due_day               Int?
  color                 String?                 @default("from-purple-600 to-indigo-700") @db.VarChar(50)
  created_at            DateTime?               @default(now()) @db.Timestamp(0)
  accounts              accounts                @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "financial_entities_account_fk")
  transactions          transactions[]
  purchase_installments purchase_installments[]
  recurring_transactions recurring_transactions[]
  card_bills            card_bills[]

  @@index([account_id], map: "financial_entities_account_idx")
}

model income_sources {
  id         Int           @id @default(autoincrement())
  user_id    Int
  name       String        @db.VarChar(50)
  color      String?       @default("#10b981") @db.VarChar(20)
  created_at DateTime?     @default(now()) @db.Timestamp(0)
  users      users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "income_sources_user_fk")
  transactions transactions[]

  @@unique([user_id, name], map: "unique_user_income_source")
  @@index([user_id], map: "income_sources_user_idx")
}

/// Fatura materializada de cartão de crédito por ciclo.
/// Status e vínculo de pagamento são a fonte única (sem heurística por string).
model card_bills {
  id                     Int              @id @default(autoincrement())
  card_id                Int
  user_id                Int
  period_start           DateTime         @db.Date
  period_end             DateTime         @db.Date
  closing_date           DateTime         @db.Date
  due_date               DateTime         @db.Date
  status                 card_bills_status @default(open)
  payment_transaction_id Int? @unique
  created_at             DateTime?        @default(now()) @db.DateTime(0)
  closed_at              DateTime?        @db.DateTime(0)
  paid_at                DateTime?        @db.DateTime(0)
  financial_entities     financial_entities @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "card_bills_card_fk")
  users                  users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "card_bills_user_fk")
  transactions           transactions?    @relation("card_bill_payment", fields: [payment_transaction_id], references: [id], onUpdate: NoAction, map: "card_bills_payment_fk")

  @@unique([card_id, period_start], map: "unique_card_period")
  @@index([card_id], map: "card_bills_card_idx")
  @@index([user_id], map: "card_bills_user_idx")
}

model recurring_events {
  id              Int                        @id @default(autoincrement())
  user_id         Int
  google_event_id String?                    @db.VarChar(255)
  title           String                     @db.VarChar(255)
  description     String?                    @db.Text
  event_time      DateTime                   @db.Time(0)
  frequency       recurring_events_frequency
  start_date      DateTime                   @db.Date
  next_event_date DateTime                   @db.Date
  status          recurring_events_status?   @default(active)
  created_at      DateTime?                  @default(now()) @db.Timestamp(0)
  end_date        DateTime?                  @db.Date
  users           users                      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recurring_events_ibfk_1")

  @@index([google_event_id], map: "idx_google_recurring_event")
  @@index([user_id], map: "user_id")
}

model recurring_transactions {
  id            Int                              @id @default(autoincrement())
  user_id       Int
  description   String                           @db.VarChar(255)
  amount        Decimal                          @db.Decimal(10, 2)
  category      String?                          @db.VarChar(50)
  type          recurring_transactions_type
  frequency     recurring_transactions_frequency
  start_date    DateTime                         @db.Date
  next_due_date DateTime                         @db.Date
  status        recurring_transactions_status?   @default(active)
  created_at    DateTime?                        @default(now()) @db.Timestamp(0)
  entity_id     Int?
  payment_method String?                         @default("cash") @db.VarChar(20)
  category_id   Int?
  users         users                            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recurring_transactions_ibfk_1")
  transactions  transactions[]                    @relation("transactions_recurring_fk")
  financial_entities financial_entities?         @relation(fields: [entity_id], references: [id], onUpdate: NoAction, map: "recurring_transactions_entity_fk")
  categories    categories?                      @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "recurring_transactions_category_fk")

  @@index([user_id], map: "user_id")
  @@index([entity_id], map: "entity_id")
  @@index([category_id], map: "category_id")
}

model reminder_logs {
  id                Int                             @id @default(autoincrement())
  user_id           Int
  event_identifier  String                          @db.VarChar(255)
  source_type       reminder_logs_source_type       @default(event)
  reminder_type_new reminder_logs_reminder_type_new @default(h)
  reminder_type     reminder_logs_reminder_type
  sent_at           DateTime?                       @default(now()) @db.Timestamp(0)
  users             users                           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reminder_user")

  @@unique([user_id, event_identifier, source_type, reminder_type_new, sent_at], map: "idx_unique_reminder_v3")
}

model reminders {
  id            Int                  @id @default(autoincrement())
  user_id       Int
  content       String               @db.Text
  trigger_time  DateTime             @db.Time(0)
  frequency     reminders_frequency? @default(once)
  specific_date DateTime?            @db.Date
  weekday       reminders_weekday?
  status        reminders_status?    @default(active)
  created_at    DateTime?            @default(now()) @db.Timestamp(0)
  users         users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reminders_ibfk_1")

  @@index([user_id], map: "user_id")
}

model purchase_installments {
  id                  Int                              @id @default(autoincrement())
  user_id             Int
  entity_id           Int
  description         String                           @db.VarChar(255)
  amount              Decimal                          @db.Decimal(10, 2)
  installment_count   Int
  installment_value   Decimal                          @db.Decimal(10, 2)
  first_installment    Int                              @default(1)
  start_date          DateTime                         @db.Date
  status              purchase_installments_status?     @default(active)
  created_at          DateTime?                        @default(now()) @db.Timestamp(0)
  users               users                            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "purchase_installments_user_fk")
  financial_entities  financial_entities               @relation(fields: [entity_id], references: [id], onUpdate: NoAction, map: "purchase_installments_entity_fk")
  transactions        transactions[]

  @@index([user_id], map: "purchase_installments_user_idx")
  @@index([entity_id], map: "purchase_installments_entity_idx")
}

model transactions {
  id                  Int                  @id @default(autoincrement())
  account_id          Int
  user_id             Int
  entity_id           Int?
  amount              Decimal              @db.Decimal(10, 2)
  type                transactions_type
  status              transactions_status? @default(paid)
  category            String?              @db.VarChar(50)
  description         String?              @db.VarChar(255)
  transaction_date    DateTime             @db.DateTime(0)
  created_at          DateTime?            @default(now()) @db.DateTime(0)
  is_recurring        Boolean?             @default(false)
  deleted_at          DateTime?            @db.DateTime(0)
  payment_method      String?              @default("cash") @db.VarChar(20)
  category_id         Int?
  income_source_id    Int?
  installment_id      Int?
  installment_number  Int?
  recurring_transaction_id Int?
  recurring_occurrence_at DateTime? @db.DateTime(0)
  financial_entities  financial_entities?  @relation(fields: [entity_id], references: [id], onUpdate: NoAction, map: "fk_transaction_entity")
  accounts            accounts             @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "transactions_ibfk_1")
  users               users                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "transactions_ibfk_2")
  categories          categories?          @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "transactions_category_fk")
  income_sources      income_sources?      @relation(fields: [income_source_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "transactions_income_source_fk")
  purchase_installments purchase_installments? @relation(fields: [installment_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "transactions_installment_fk")
  recurring_transactions recurring_transactions? @relation("transactions_recurring_fk", fields: [recurring_transaction_id], references: [id])
  card_bill_paid        card_bills?           @relation("card_bill_payment")

  @@index([account_id], map: "account_id")
  @@index([entity_id], map: "fk_transaction_entity")
  @@index([user_id], map: "user_id")
  @@index([category_id], map: "category_id")
  @@index([income_source_id], map: "income_source_id")
  @@index([installment_id], map: "installment_id")
  @@index([recurring_transaction_id], map: "recurring_transaction_id")
  @@unique([recurring_transaction_id, recurring_occurrence_at], map: "transactions_recurring_occurrence_uq")
}

model scheduler_locks {
  job_name     String   @id @db.VarChar(100)
  owner_id     String   @db.VarChar(100)
  locked_until DateTime @db.DateTime(3)
  updated_at   DateTime @updatedAt @db.DateTime(3)
}

model scheduler_runs {
  id            BigInt    @id @default(autoincrement())
  job_name      String    @db.VarChar(100)
  execution_key String    @db.VarChar(191)
  owner_id      String    @db.VarChar(100)
  status        String    @default("running") @db.VarChar(20)
  attempts      Int       @default(1)
  started_at    DateTime  @default(now()) @db.DateTime(3)
  finished_at   DateTime? @db.DateTime(3)
  duration_ms   Int?
  result        Json?
  error_message String?   @db.Text

  @@unique([job_name, execution_key])
  @@index([status, started_at])
}

model reminder_deliveries {
  id              BigInt    @id @default(autoincrement())
  source_type     String    @db.VarChar(30)
  source_id       String    @db.VarChar(191)
  occurrence_key  String    @db.VarChar(191)
  account_id      Int
  user_id         Int
  destination     String    @db.VarChar(50)
  message         String    @db.Text
  status          String    @default("pending") @db.VarChar(20)
  attempts        Int       @default(0)
  max_attempts    Int       @default(5)
  next_attempt_at DateTime  @default(now()) @db.DateTime(3)
  locked_by       String?   @db.VarChar(100)
  locked_until    DateTime? @db.DateTime(3)
  last_error      String?   @db.Text
  provider_result Json?
  created_at      DateTime  @default(now()) @db.DateTime(3)
  sent_at         DateTime? @db.DateTime(3)
  failed_at       DateTime? @db.DateTime(3)

  @@unique([source_type, source_id, occurrence_key])
  @@index([status, next_attempt_at, locked_until])
  @@index([account_id])
  @@index([user_id])
}

/// Desafios OTP (códigos de verificação) para primeiro acesso e recuperação de senha.
/// Apenas o hash do código é persistido — o código em texto plano nunca é armazenado.
model otp_challenges {
  id            Int       @id @default(autoincrement())
  /// SHA-256 do código OTP (nunca o código em texto plano).
  code_hash     String    @db.VarChar(128)
  /// Finalidade: "first_access" ou "password_reset".
  purpose       String    @db.VarChar(30)
  /// ID do usuário alvo (FK).
  user_id       Int
  /// Telefone normalizado do usuário (para lookup sem join).
  phone_number  String    @db.VarChar(50)
  /// Contador de tentativas de validação.
  attempts      Int       @default(0)
  /// Máximo de tentativas antes do bloqueio.
  max_attempts  Int       @default(5)
  /// Indica se o código já foi consumido (impede reutilização).
  consumed      Boolean   @default(false)
  expires_at    DateTime  @db.DateTime(0)
  created_at    DateTime  @default(now()) @db.DateTime(0)

  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "otp_challenges_user_fk")

  @@index([user_id], map: "otp_challenges_user_idx")
  @@index([phone_number, purpose], map: "otp_challenges_phone_purpose_idx")
}

/// Ações pendentes que exigem confirmação do usuário antes de executar.
/// Ex.: exclusões, alterações em lote, criação de recorrências.
model pending_actions {
  id            Int       @id @default(autoincrement())
  /// ID do usuário que solicitou a ação.
  user_id       Int
  /// ID da conta (tenant) do usuário.
  account_id    Int
  /// Tipo da ação (ex: "delete_transaction", "create_recurring", "bulk_import").
  action_type   String    @db.VarChar(60)
  /// Payload validado da ação (JSON serializado).
  payload       String    @db.Text
  /// Chave de idempotência (ex.: hash do documento de importação). Quando presente, evita duplicidade.
  idempotency_key String?  @unique @db.VarChar(128)
  /// Resumo legível para o usuário (ex: "Excluir: Mercado R$ 50,00 de hoje").
  summary       String    @db.VarChar(500)
  /// Estado anterior (JSON) para auditoria e desfazer.
  before_state  String?   @db.Text
  /// Status: "pending", "confirmed", "cancelled", "expired", "executed".
  status        String    @default("pending") @db.VarChar(20)
  /// Data de expiração (confirmação deve ocorrer antes).
  expires_at    DateTime  @db.DateTime(0)
  created_at    DateTime  @default(now()) @db.DateTime(0)
  confirmed_at  DateTime? @db.DateTime(0)
  executed_at   DateTime? @db.DateTime(0)

  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pending_actions_user_fk")

  @@index([user_id], map: "pending_actions_user_idx")
  @@index([account_id], map: "pending_actions_account_idx")
  @@index([status], map: "pending_actions_status_idx")
}

/// Registro de auditoria para ações do agente (estado anterior e posterior).
model action_audit {
  id            Int       @id @default(autoincrement())
  user_id       Int
  account_id    Int
  /// Tipo da ação auditada.
  action_type   String    @db.VarChar(60)
  /// "execute" (direto), "confirm" (confirmou pendente), "undo" (desfazer).
  execution     String    @default("execute") @db.VarChar(20)
  /// Estado anterior (JSON).
  before_state  String?   @db.Text
  /// Estado posterior (JSON).
  after_state   String?   @db.Text
  created_at    DateTime  @default(now()) @db.DateTime(0)

  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "action_audit_user_fk")

  @@index([user_id], map: "action_audit_user_idx")
  @@index([account_id], map: "action_audit_account_idx")
}

model refresh_tokens {
  id         Int       @id @default(autoincrement())
  token_hash String    @unique @db.VarChar(128)
  token      String    @db.VarChar(512)
  family_id  String    @db.VarChar(128)
  user_id    Int
  expires_at DateTime  @db.DateTime(0)
  created_at DateTime  @default(now()) @db.DateTime(0)
  revoked_at DateTime? @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_user_fk")

  @@index([user_id], map: "refresh_tokens_user_idx")
  @@index([family_id], map: "refresh_tokens_family_idx")
}

model users {
  id                     Int                      @id @default(autoincrement())
  account_id             Int
  phone_number           String                   @unique(map: "phone_number") @db.VarChar(50)
  password_hash          String?                  @db.VarChar(255)
  name                   String?                  @db.VarChar(100)
  role                   users_role?              @default(admin)
  status                 users_status?            @default(active)
  created_at             DateTime?                @default(now()) @db.DateTime(0)
  email                  String?                  @db.VarChar(150)
  google_refresh_token   String?                  @db.VarChar(512)
  google_email           String?                  @db.VarChar(255)
  google_calendar_id     String?                  @default("primary") @db.VarChar(255)
  refresh_tokens         refresh_tokens[]
  otp_challenges         otp_challenges[]
  pending_actions        pending_actions[]
  action_audit           action_audit[]
  budgets                budgets[]
  events                 events[]
  income_sources         income_sources[]
  recurring_events       recurring_events[]
  recurring_transactions recurring_transactions[]
  reminder_logs          reminder_logs[]
  reminders              reminders[]
  purchase_installments   purchase_installments[]
  transactions           transactions[]
  card_bills             card_bills[]
  legal_consents         legal_consents[]
  data_subject_requests  data_subject_requests[]
  accounts               accounts                 @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "users_ibfk_1")

  @@index([account_id], map: "account_id")
}

enum reminder_logs_source_type {
  event
  transaction
  reminder
}

enum financial_entities_type {
  bank
  credit_card
}

enum accounts_status {
  trial
  active
  expired
  past_due
  cancelled
  suspended
}

model legal_consents {
  id                BigInt   @id @default(autoincrement())
  user_id           Int
  account_id        Int
  document_type     String   @db.VarChar(30)
  document_version  String   @db.VarChar(30)
  accepted_at       DateTime @default(now()) @db.DateTime(3)
  origin            String   @db.VarChar(30)
  ip_hash           String?  @db.VarChar(64)
  user_agent         String?  @db.VarChar(255)
  evidence           Json?
  users              users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, document_type, document_version])
  @@index([account_id, accepted_at])
}

model data_subject_requests {
  id                BigInt    @id @default(autoincrement())
  user_id           Int
  account_id        Int
  request_type      String    @db.VarChar(30)
  status            String    @default("requested") @db.VarChar(30)
  requested_at      DateTime  @default(now()) @db.DateTime(3)
  due_at             DateTime? @db.DateTime(3)
  completed_at       DateTime? @db.DateTime(3)
  cancellation_at    DateTime? @db.DateTime(3)
  result             Json?
  last_error         String?   @db.Text
  users              users     @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, due_at])
  @@index([account_id, requested_at])
}

model privacy_audit_events {
  id            BigInt   @id @default(autoincrement())
  user_id       Int?
  account_id    Int?
  event_type    String   @db.VarChar(60)
  target_type   String?  @db.VarChar(60)
  target_id     String?  @db.VarChar(100)
  outcome       String   @db.VarChar(20)
  metadata      Json?
  created_at    DateTime @default(now()) @db.DateTime(3)

  @@index([account_id, created_at])
