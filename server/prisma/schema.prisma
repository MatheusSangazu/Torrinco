model legal_consents {
  id               BigInt   @id @default(autoincrement())
  user_id          Int
  account_id       Int
  document_type    String   @db.VarChar(30)
  document_version String   @db.VarChar(30)
  accepted_at      DateTime @default(now()) @db.DateTime(3)
  origin           String   @db.VarChar(30)
  ip_hash          String?  @db.VarChar(64)
  user_agent       String?  @db.VarChar(255)
  evidence         Json?
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, document_type, document_version])
  @@index([account_id, accepted_at])
}

model data_subject_requests {
  id              BigInt    @id @default(autoincrement())
  user_id         Int
  account_id      Int
  request_type    String    @db.VarChar(30)
  status          String    @default("requested") @db.VarChar(30)
  requested_at    DateTime  @default(now()) @db.DateTime(3)
  due_at          DateTime? @db.DateTime(3)
  completed_at    DateTime? @db.DateTime(3)
  cancellation_at DateTime? @db.DateTime(3)
  result          Json?
  last_error      String?   @db.Text
  users           users     @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, due_at])
  @@index([account_id, requested_at])
}

model privacy_audit_events {
  id          BigInt   @id @default(autoincrement())
  user_id     Int?
  account_id  Int?
  event_type  String   @db.VarChar(60)
  target_type String?  @db.VarChar(60)
  target_id   String?  @db.VarChar(100)
  outcome     String   @db.VarChar(20)
  metadata    Json?
  created_at  DateTime @default(now()) @db.DateTime(3)

  @@index([account_id, created_at])
  @@index([user_id, created_at])
  @@index([event_type, created_at])
}

/// Lote persistente de importacao financeira. O arquivo original nao e armazenado.
model financial_imports {
  id                        Int                      @id @default(autoincrement())
  account_id                Int
  user_id                   Int
  target_entity_id          Int?
  file_name                 String                   @db.VarChar(255)
  file_hash                 String                   @db.Char(64)
  mime_type                 String                   @db.VarChar(100)
  file_size                 Int
  document_type             import_document_type     @default(unknown)
  status                    financial_import_status  @default(uploaded)
  issuer                    String?                  @db.VarChar(120)
  card_last_four            String?                  @db.Char(4)
  holder_name               String?                  @db.VarChar(120)
  period_start              DateTime?                @db.Date
  period_end                DateTime?                @db.Date
  closing_date              DateTime?                @db.Date
  due_date                  DateTime?                @db.Date
  document_total            Decimal?                 @db.Decimal(12, 2)
  selected_expense_total    Decimal                  @default(0) @db.Decimal(12, 2)
  selected_income_total     Decimal                  @default(0) @db.Decimal(12, 2)
  selected_total            Decimal                  @default(0) @db.Decimal(12, 2)
  reconciliation_difference Decimal?                 @db.Decimal(12, 2)
  difference_reason         String?                  @db.VarChar(500)
  warning_message           String?                  @db.VarChar(500)
  confirmed_at              DateTime?                @db.DateTime(3)
  completed_at              DateTime?                @db.DateTime(3)
  cancelled_at              DateTime?                @db.DateTime(3)
  created_at                DateTime                 @default(now()) @db.DateTime(3)
  updated_at                DateTime                 @updatedAt @db.DateTime(3)
  accounts                  accounts                 @relation(fields: [account_id], references: [id], onDelete: Cascade)
  users                     users                    @relation(fields: [user_id], references: [id], onDelete: Restrict)
  target_entity             financial_entities?      @relation(fields: [target_entity_id], references: [id], onDelete: SetNull)
  items                     financial_import_items[]

  @@index([account_id, user_id, created_at])
  @@index([account_id, file_hash])
  @@index([status, created_at])
}

/// Linha estruturada e revisavel extraida de um lote.
model financial_import_items {
  id                      Int                 @id @default(autoincrement())
  import_id               Int
  edited_by_user_id       Int?
  row_index               Int
  included                Boolean             @default(true)
  transaction_date        DateTime            @db.Date
  original_description    String              @db.VarChar(500)
  description             String              @db.VarChar(255)
  original_excerpt        String?             @db.VarChar(1000)
  amount                  Decimal             @db.Decimal(12, 2)
  type                    transactions_type
  category_id             Int?
  entity_id               Int?
  payment_method          String?             @db.VarChar(30)
  transaction_status      transactions_status @default(paid)
  item_kind               import_item_kind    @default(unknown)
  confidence              Decimal             @default(0.5) @db.Decimal(4, 3)
  requires_review         Boolean             @default(false)
  duplicate_kind          String?             @db.VarChar(40)
  duplicate_reason        String?             @db.VarChar(255)
  exclusion_reason        String?             @db.VarChar(255)
  fingerprint             String              @db.Char(64)
  imported_transaction_id Int?                @unique
  created_at              DateTime            @default(now()) @db.DateTime(3)
  updated_at              DateTime            @updatedAt @db.DateTime(3)
  financial_imports       financial_imports   @relation(fields: [import_id], references: [id], onDelete: Cascade)
  edited_by               users?              @relation("import_item_editor", fields: [edited_by_user_id], references: [id], onDelete: SetNull)
  categories              categories?         @relation(fields: [category_id], references: [id], onDelete: SetNull)
  financial_entities      financial_entities? @relation(fields: [entity_id], references: [id], onDelete: SetNull)
  imported_transaction    transactions?       @relation(fields: [imported_transaction_id], references: [id], onDelete: SetNull)

  @@unique([import_id, row_index])
  @@index([import_id, included])
  @@index([fingerprint])
}

