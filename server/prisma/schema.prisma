  target_user       users?    @relation("platform_audit_target", fields: [target_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  target_account    accounts? @relation(fields: [target_account_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([actor_user_id, created_at])
