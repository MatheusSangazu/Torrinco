# =============================================================================
# BANCO DE DADOS
# =============================================================================
# DATABASE_URL é usada pelo Prisma CLI. As demais são usadas pelo servidor.
# Mantenha host, porta, usuário, senha e database iguais nos dois formatos.
DATABASE_URL="mysql://user:password@localhost:3306/database_name"
DATABASE_HOST="localhost"
DATABASE_PORT=3306
DATABASE_NAME="database_name"
DATABASE_USER="user"
DATABASE_PASSWORD="password"

# =============================================================================
# AUTENTICAÇÃO E SESSÃO
# =============================================================================
# Use um segredo longo, aleatório e diferente em cada ambiente.
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="torrinco"
JWT_AUDIENCE="torrinco-users"

# =============================================================================
# SERVIDOR, CORS E URLs PÚBLICAS
# =============================================================================
PORT=3001
NODE_ENV="development"
# O processo opera em UTC; regras civis usam America/Fortaleza na aplicação.
TZ="UTC"
# Origins separadas por vírgula, sem caminho e sem barra final.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-production-domain.com"
PUBLIC_APP_URL="http://localhost:5173"
PUBLIC_LEGAL_BASE_URL="http://localhost:3001"
# Quantidade de proxies confiáveis à frente do Express. Em local, normalmente 0.
TRUST_PROXY_HOPS=0

# =============================================================================
# AGENTE E OPENAI
# =============================================================================
AGENT_API_KEY="replace-with-a-random-internal-api-key"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"

# =============================================================================
# WHATSAPP — EVOLUTION API
# =============================================================================
EVOLUTION_API_URL="https://your-evolution-api.com"
EVOLUTION_API_KEY="your_evolution_api_key"
EVOLUTION_INSTANCE_NAME="your_instance_name"
# Mesmo valor de autenticação configurado no webhook da Evolution.
EVOLUTION_WEBHOOK_API_KEY="your_evolution_webhook_api_key"

# =============================================================================
# GOOGLE CALENDAR
# =============================================================================
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxx"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/google/callback"

# =============================================================================
# ASSINATURA E REGRAS COMERCIAIS
# =============================================================================
BILLING_GRACE_PERIOD_DAYS=0
# Valores aceitos: suspend | keep_until_period_end
BILLING_REFUND_POLICY="suspend"

# =============================================================================
# PRIVACIDADE E RETENÇÃO
# =============================================================================
PRIVACY_DELETION_GRACE_DAYS=0
# Deixe vazio enquanto não houver uma política jurídica definida.
PRIVACY_FINANCIAL_RETENTION_DAYS=
PRIVACY_AUDIT_RETENTION_DAYS=
PRIVACY_AUDIT_SALT="replace-with-an-independent-random-secret"

# =============================================================================
# ADMINISTRAÇÃO DA PLATAFORMA E CONVITES
# =============================================================================
PLATFORM_OWNER_USER_ID=
# Valores aceitos pelo script: promote | demote
PLATFORM_OWNER_ACTION="promote"
PLATFORM_INVITE_EXPIRES_HOURS=72
PLATFORM_ADMIN_RECENT_AUTH_SECONDS=900

# =============================================================================
# IMPORTAÇÃO E DOCUMENTOS
# =============================================================================
IMPORT_CENTER_ENABLED=true
IMPORT_MAX_FILE_BYTES=10485760
IMPORT_MAX_EXTRACTED_CHARS=250000
WHATSAPP_DOCUMENT_MAX_CHARS=120000

# =============================================================================
# CADASTRO AUTOMÁTICO PELO WHATSAPP
# =============================================================================
# Mantenha false quando o acesso for somente por convite.
ALLOW_AUTO_ONBOARDING=false

# =============================================================================
# VARIÁVEIS DO PROVEDOR (OPCIONAIS)
# =============================================================================
# SERVICE_* é normalmente injetado pelo Coolify e não é lido pela aplicação.
# SERVICE_URL_CLIENT=https://your-app-domain.com
# SERVICE_FQDN_CLIENT=your-app-domain.com
# SERVICE_URL_SERVER=https://your-api-domain.com
# SERVICE_FQDN_SERVER=your-api-domain.com
#
# VITE_API_URL não pertence a este arquivo. Configure-a em client/.env.
