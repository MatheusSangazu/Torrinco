# Database Configuration
DATABASE_URL="mysql://user:password@localhost:3306/database_name"
DATABASE_USER="your_db_user"
DATABASE_PASSWORD="your_secure_password"
DATABASE_NAME="your_database_name"
DATABASE_HOST="localhost"
DATABASE_PORT=3306

# JWT Configuration
JWT_SECRET="your_super_secure_jwt_secret_minimum_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="torrinco"
JWT_AUDIENCE="torrinco-users"

# Evolution API Configuration
EVOLUTION_API_URL="https://your-evolution-api.com/"
EVOLUTION_API_KEY="your_evolution_api_key"
EVOLUTION_INSTANCE_NAME="your_instance_name"

# Server Configuration
PORT=3001
NODE_ENV="development"
# O processo deve operar em UTC; o fuso da conta é resolvido pela aplicação.
TZ="UTC"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://your-production-domain.com"


AGENT_API_KEY="your_secure_agent_api_key"

# OpenAI 
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"

# Google Calendar
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxx"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/google/callback"

# Segurança de webhook — API Key que a Evolution envia no header `apikey`.
# Usar o MESMO valor configurado como AUTHENTICATION_API_KEY na Evolution
# (ou o token da instância específica). Sem isso, o webhook é recusado em produção (401).
EVOLUTION_WEBHOOK_API_KEY="mesmo-valor-do-AUTHENTICATION_API_KEY-da-evolution"
# Decisao comercial pendente. Zero bloqueia imediatamente apos o periodo pago.
BILLING_GRACE_PERIOD_DAYS=0

# Privacidade: revisar juridicamente antes de definir retenções positivas.
PRIVACY_DELETION_GRACE_DAYS=0
# PRIVACY_FINANCIAL_RETENTION_DAYS=
# PRIVACY_AUDIT_RETENTION_DAYS=
PRIVACY_AUDIT_SALT="change-me-independent-secret"
PUBLIC_LEGAL_BASE_URL="https://your-api-domain.com"
PUBLIC_APP_URL="https://your-app-domain.com"
PLATFORM_OWNER_USER_ID=
PLATFORM_OWNER_ACTION="promote"
PLATFORM_INVITE_EXPIRES_HOURS=72
PLATFORM_ADMIN_RECENT_AUTH_SECONDS=900

# Central de Importação
IMPORT_CENTER_ENABLED=true
IMPORT_MAX_FILE_BYTES=10485760
IMPORT_MAX_EXTRACTED_CHARS=250000
WHATSAPP_DOCUMENT_MAX_CHARS=120000

# Cadastro automático por WhatsApp. Manter desabilitado quando o acesso for somente por convite.
ALLOW_AUTO_ONBOARDING=false

# Política aplicada após reembolso confirmado: suspend | keep_until_period_end
BILLING_REFUND_POLICY="suspend"
TRUST_PROXY_HOPS=1
