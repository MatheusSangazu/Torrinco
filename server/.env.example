# Database Configuration
DATABASE_URL="mysql://user:password@localhost:3306/database_name"
DATABASE_USER="your_db_user"
DATABASE_PASSWORD="your_secure_password"
DATABASE_NAME="your_database_name"
DATABASE_HOST="localhost"
DATABASE_PORT=3306

# JWT Configuration
JWT_SECRET="your_super_secure_jwt_secret_minimum_32_chars"
JWT_EXPIRES_IN="7d"

# Evolution API Configuration
EVOLUTION_API_URL="https://your-evolution-api.com/"
EVOLUTION_API_KEY="your_evolution_api_key"
EVOLUTION_INSTANCE_NAME="your_instance_name"

# Server Configuration
PORT=3001
NODE_ENV="development"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://your-production-domain.com"

# Agent API Key (camada agent-friendly / n8n / IA)
# Header: x-api-key + x-user-id (single-user: x-user-id opcional)
AGENT_API_KEY="your_secure_agent_api_key"

# OpenAI (agente de IA do WhatsApp — FASE 8)
OPENAI_API_KEY="your_openai_api_key"
